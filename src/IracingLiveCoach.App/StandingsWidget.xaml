<Window x:Class="IracingLiveCoach.App.StandingsWidget" x:Name="Root" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Standings" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True" ShowInTaskbar="False" MinWidth="560" MinHeight="460" SizeToContent="Manual">
<Grid Background="Transparent" MouseLeftButtonDown="OnBackgroundMouseLeftButtonDown"><Border x:Name="OuterBorder" Background="#F008131E" BorderBrush="#FF76828B" BorderThickness="1,0,1,1" RenderOptions.BitmapScalingMode="HighQuality"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="5"/><RowDefinition Height="Auto"/><RowDefinition Height="38"/><RowDefinition Height="28"/><RowDefinition Height="*"/><RowDefinition Height="32"/></Grid.RowDefinitions><Border Background="{StaticResource F1AccentBrush}"/><StackPanel Grid.Row="1" Margin="0,8,0,0"><TextBlock Text="{Binding ClassSessionText}" FontFamily="{StaticResource F1HeaderFont}" FontSize="20" FontWeight="Bold" Foreground="White"/></StackPanel><Grid Grid.Row="2"><TextBlock Text="{Binding LapText}" FontFamily="{StaticResource F1MonoFont}" FontSize="20" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/><TextBlock Text="{Binding FlagText}" FontFamily="{StaticResource F1MonoFont}" FontSize="17" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid><Border Grid.Row="3" BorderBrush="#FF52606B" BorderThickness="0,1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="{Binding ElementName=Root, Path=DataContext.PosColumnWidth, Mode=TwoWay}"/><ColumnDefinition Width="*"/><ColumnDefinition Width="{Binding ElementName=Root, Path=DataContext.LicColumnWidth, Mode=TwoWay}"/><ColumnDefinition Width="{Binding ElementName=Root, Path=DataContext.IRatingColumnWidth, Mode=TwoWay}"/><ColumnDefinition Width="{Binding ElementName=Root, Path=DataContext.GapColumnWidth, Mode=TwoWay}"/><ColumnDefinition Width="{Binding ElementName=Root, Path=DataContext.LastLapColumnWidth, Mode=TwoWay}"/><ColumnDefinition Width="{Binding ElementName=Root, Path=DataContext.DeltaColumnWidth, Mode=TwoWay}"/></Grid.ColumnDefinitions><TextBlock Text="POS" Style="{StaticResource HeaderCell}"/><TextBlock Grid.Column="1" Text="PILOTO" Style="{StaticResource HeaderCell}"/><TextBlock Grid.Column="2" Text="LIC." Style="{StaticResource HeaderCell}"/><TextBlock Grid.Column="3" Text="iR" Style="{StaticResource HeaderCell}"/><TextBlock Grid.Column="4" Text="{Binding GapHeaderText}" Style="{StaticResource HeaderCell}"/><TextBlock Grid.Column="5" Text="ÚLT. VOLTA" Style="{StaticResource HeaderCell}"/><TextBlock Grid.Column="6" Text="Δ VOLTA" Style="{StaticResource HeaderCell}"/><GridSplitter Grid.Column="1" Width="6" Margin="-3,0,0,0" HorizontalAlignment="Left" Background="Transparent" ResizeBehavior="PreviousAndNext"/><GridSplitter Grid.Column="2" Width="6" Margin="-3,0,0,0" HorizontalAlignment="Left" Background="Transparent" ResizeBehavior="PreviousAndNext"/><GridSplitter Grid.Column="3" Width="6" Margin="-3,0,0,0" HorizontalAlignment="Left" Background="Transparent" ResizeBehavior="PreviousAndNext"/><GridSplitter Grid.Column="4" Width="6" Margin="-3,0,0,0" HorizontalAlignment="Left" Background="Transparent" ResizeBehavior="PreviousAndNext"/><GridSplitter Grid.Column="5" Width="6" Margin="-3,0,0,0" HorizontalAlignment="Left" Background="Transparent" ResizeBehavior="PreviousAndNext"/><GridSplitter Grid.Column="6" Width="6" Margin="-3,0,0,0" HorizontalAlignment="Left" Background="Transparent" ResizeBehavior="PreviousAndNext"/></Grid></Border><ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Hidden"><ItemsControl ItemsSource="{Binding Rows}"><ItemsControl.ItemTemplate><DataTemplate><Border Height="42" BorderBrush="#503F5362" BorderThickness="0,0,0,1"><Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding IsPlayer}" Value="True"><Setter Property="Background" Value="{StaticResource F1HighlightBrush}"/></DataTrigger></Style.Triggers></Style></Border.Style><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="{Binding ElementName=Root, Path=DataContext.PosColumnWidth, Mode=TwoWay}"/><ColumnDefinition Width="*"/><ColumnDefinition Width="{Binding ElementName=Root, Path=DataContext.LicColumnWidth, Mode=TwoWay}"/><ColumnDefinition Width="{Binding ElementName=Root, Path=DataContext.IRatingColumnWidth, Mode=TwoWay}"/><ColumnDefinition Width="{Binding ElementName=Root, Path=DataContext.GapColumnWidth, Mode=TwoWay}"/><ColumnDefinition Width="{Binding ElementName=Root, Path=DataContext.LastLapColumnWidth, Mode=TwoWay}"/><ColumnDefinition Width="{Binding ElementName=Root, Path=DataContext.DeltaColumnWidth, Mode=TwoWay}"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><Border Width="3" Height="20" Background="{Binding ClassAccentBrush}" CornerRadius="1.5" Margin="0,0,5,0" Visibility="{Binding HasClassBadge, Converter={StaticResource BoolToVisibilityConverter}}"/><TextBlock Text="{Binding PositionText}" FontFamily="{StaticResource F1MonoFont}" FontSize="18" FontWeight="SemiBold" Foreground="{Binding PositionBrush}"/></StackPanel><Grid Grid.Column="1" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="20" Height="13" BorderBrush="#B0FFFFFF" BorderThickness="1" Margin="0,0,5,0"><Image Source="{Binding FlagImagePath}" Stretch="Fill"/></Border><Border Grid.Column="1" Width="20" Height="20" CornerRadius="4" Background="#FFEEF2F5" Margin="0,0,5,0" Visibility="{Binding HasBrandIcon, Converter={StaticResource BoolToVisibilityConverter}}"><Grid><Image Source="{Binding BrandImagePath}" Width="14" Height="14" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Visibility="{Binding HasBrandImage, Converter={StaticResource BoolToVisibilityConverter}}"/><Viewbox Width="12" Height="12" Visibility="{Binding HasBrandPath, Converter={StaticResource BoolToVisibilityConverter}}"><Canvas Width="24" Height="24"><Path Data="{Binding BrandPathData}" Fill="{Binding BrandColorBrush}"/></Canvas></Viewbox></Grid></Border><TextBlock Grid.Column="2" Text="{Binding FlagAndCode}" FontFamily="{StaticResource F1MonoFont}" FontSize="14" FontWeight="SemiBold" Foreground="{Binding RowForegroundBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></Grid><Border Grid.Column="2" Background="{Binding LicBrush}" Padding="3,2" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock Text="{Binding LicText}" FontFamily="{StaticResource F1MonoFont}" FontSize="12" FontWeight="SemiBold" Foreground="#FF0B1420"/></Border><StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{Binding IRatingText}" FontFamily="{StaticResource F1MonoFont}" FontSize="13" Foreground="{Binding RowForegroundBrush}"/><TextBlock Text="{Binding IRatingDeltaText}" FontFamily="{StaticResource F1MonoFont}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding IRatingDeltaBrush}" Margin="3,2,0,0"/></StackPanel><TextBlock Grid.Column="4" Text="{Binding GapText}" FontFamily="{StaticResource F1MonoFont}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding RowForegroundBrush}" VerticalAlignment="Center"/><TextBlock Grid.Column="5" Text="{Binding LastLapText}" FontFamily="{StaticResource F1MonoFont}" FontSize="13" FontWeight="SemiBold" Foreground="{Binding RowForegroundBrush}" VerticalAlignment="Center"/><TextBlock Grid.Column="6" Text="{Binding LapDeltaText}" FontFamily="{StaticResource F1MonoFont}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding LapDeltaBrush}" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer><Border Grid.Row="5" BorderBrush="#FF52606B" BorderThickness="0,1,0,0"><Grid><TextBlock Text="{Binding SofText}" FontFamily="{StaticResource F1MonoFont}" FontSize="14" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/><TextBlock Text="{Binding DriverCountText}" FontFamily="{StaticResource F1MonoFont}" FontSize="12" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Border></Grid></Border><Thumb x:Name="ResizeGrip" Width="1