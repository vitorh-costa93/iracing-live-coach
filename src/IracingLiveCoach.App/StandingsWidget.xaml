<Window x:Class="IracingLiveCoach.App.StandingsWidget" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Standings" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True" ShowInTaskbar="False" MinWidth="320" MinHeight="190"><Grid Background="Transparent" MouseLeftButtonDown="OnBackgroundMouseLeftButtonDown"><Border x:Name="OuterBorder" Background="#ED08131E" BorderBrush="#FF76828B" BorderThickness="1"><Grid Margin="9"><Grid.RowDefinitions><RowDefinition Height="4"/><RowDefinition Height="23"/><RowDefinition Height="25"/><RowDefinition Height="22"/><RowDefinition Height="*"/><RowDefinition Height="24"/></Grid.RowDefinitions><Border Background="{StaticResource F1AccentBrush}"/><TextBlock Grid.Row="1" Text="{Binding ClassSessionText}" FontFamily="{StaticResource F1HeaderFont}" FontSize="14" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/><Grid Grid.Row="2"><TextBlock Text="{Binding LapText}" FontFamily="{StaticResource F1MonoFont}" FontSize="14" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/><TextBlock Text="{Binding FlagText}" FontFamily="{StaticResource F1MonoFont}" FontSize="11" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid><Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="38"/><ColumnDefinition Width="42"/><ColumnDefinition Width="48"/><ColumnDefinition Width="65"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions><TextBlock Text="POS" Style="{StaticResource HeaderCell}"/><TextBlock Grid.Column="1" Text="PILOTO" Style="{StaticResource HeaderCell}"/><TextBlock Grid.Column="2" Text="LIC." Style="{StaticResource HeaderCell}"/><TextBlock Grid.Column="3" Text="iR" Style="{StaticResource HeaderCell}"/><TextBlock Grid.Column="4" Text="GAP" Style="{StaticResource HeaderCell}"/><TextBlock Grid.Column="5" Text="VOLTA" 