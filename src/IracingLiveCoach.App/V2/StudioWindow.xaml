<Window x:Class="IracingLiveCoach.V2.StudioWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Live Coach · Overlay Studio" Width="520" Height="760" Background="#FF080B10" Foreground="#FFF4F7FA" WindowStartupLocation="CenterScreen" Topmost="True" ShowInTaskbar="True">
  <Window.Resources>
    <Style TargetType="Button"><Setter Property="FontFamily" Value="{StaticResource OverlayFont}"/><Setter Property="Background" Value="#FF16202B"/><Setter Property="Foreground" Value="#FFF4F7FA"/><Setter Property="BorderBrush" Value="#FF344352"/><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="4,0,0,0"/></Style>
    <Style TargetType="Expander"><Setter Property="Background" Value="#FF0E141C"/><Setter Property="BorderBrush" Value="#FF263442"/><Setter Property="BorderThickness" Value="1"/></Style>
    <Style x:Key="Section" TargetType="TextBlock"><Setter Property="FontSize" Value="10"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="#FF4DE95F"/><Setter Property="Margin" Value="0,12,0,5"/></Style>
    <Style x:Key="Hint" TargetType="TextBlock"><Setter Property="FontSize" Value="10"/><Setter Property="Foreground" Value="#FFB8C5D7"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
    <Style TargetType="ComboBox"><Setter Property="FontFamily" Value="{StaticResource OverlayFont}"/><Setter Property="FontWeight" Value="Medium"/><Setter Property="Background" Value="#FF18222D"/><Setter Property="Foreground" Value="#FFF4F7FA"/><Setter Property="BorderBrush" Value="#FF52677A"/><Setter Property="Padding" Value="8,4"/></Style>
    <Style TargetType="ComboBoxItem"><Setter Property="FontFamily" Value="{StaticResource OverlayFont}"/><Setter Property="FontWeight" Value="Medium"/><Setter Property="Background" Value="#FF18222D"/><Setter Property="Foreground" Value="#FFF4F7FA"/><Setter Property="Padding" Value="8,5"/></Style>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Background="#FF0E141C" BorderBrush="#FF263442" BorderThickness="0,0,0,1" Padding="22,17">
      <DockPanel>
        <StackPanel><TextBlock Text="OVERLAY STUDIO" FontSize="21" FontWeight="Bold"/><TextBlock Text="Personalize, position and lock for driving" Foreground="#FFB8C5D7" FontSize="11" Margin="0,3,0,0"/></StackPanel>
        <Button DockPanel.Dock="Right" Content="{Binding LockLabel}" Command="{Binding ToggleLockCommand}" Background="#FF4DE95F" Foreground="#FF06110A" BorderBrush="#FF4DE95F" FontWeight="Bold" VerticalAlignment="Center"/>
      </DockPanel>
    </Border>
    <Border Grid.Row="1" Margin="18,14,18,8" Background="#151B9DB5" BorderBrush="#4033DAEC" BorderThickness="1" CornerRadius="6" Padding="10,8">
      <TextBlock Text="Unlocked: drag the card and resize from the pink corner. Locked: cards become click-through." TextWrapping="Wrap" Foreground="#FFB8D7E1" FontSize="10"/>
    </Border>
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="18,0,12,18">
      <ItemsControl ItemsSource="{Binding Widgets}">
        <ItemsControl.ItemTemplate><DataTemplate>
          <Expander Margin="0,5" IsExpanded="{Binding Enabled}">
            <Expander.Header>
              <Grid Width="446" Margin="10,7"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <CheckBox IsChecked="{Binding Enabled}" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="13"/><TextBlock Text="Widget-specific configuration" Foreground="#FFB8C5D7" FontSize="9"/></StackPanel>
                <TextBlock Grid.Column="2" Text="EDIT" Foreground="#FF4DE95F" FontWeight="Bold" FontSize="9" VerticalAlignment="Center"/>
              </Grid>
            </Expander.Header>
            <StackPanel Margin="15,4,15,15">
              <TextBlock Text="SIZE &amp; POSITION" Style="{StaticResource Section}"/>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="88"/><ColumnDefinition Width="*"/><ColumnDefinition Width="45"/></Grid.ColumnDefinitions><TextBlock Text="Fonte" Style="{StaticResource Hint}"/><Slider Grid.Column="1" Minimum="0.65" Maximum="1.45" Value="{Binding FontScale}"/><TextBlock Grid.Column="2" Text="{Binding FontScale, StringFormat={}{0:P0}}" HorizontalAlignment="Right" Style="{StaticResource Hint}"/></Grid>
              <Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="88"/><ColumnDefinition Width="*"/><ColumnDefinition Width="45"/></Grid.ColumnDefinitions><TextBlock Text="Width" Style="{StaticResource Hint}"/><Slider Grid.Column="1" Minimum="180" Maximum="1600" Value="{Binding Width}"/><TextBlock Grid.Column="2" Text="{Binding Width, StringFormat={}{0:0}px}" HorizontalAlignment="Right" Style="{StaticResource Hint}"/></Grid>
              <Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="88"/><ColumnDefinition Width="*"/><ColumnDefinition Width="45"/></Grid.ColumnDefinitions><TextBlock Text="Height" Style="{StaticResource Hint}"/><Slider Grid.Column="1" Minimum="75" Maximum="1600" Value="{Binding Height}"/><TextBlock Grid.Column="2" Text="{Binding Height, StringFormat={}{0:0}px}" HorizontalAlignment="Right" Style="{StaticResource Hint}"/></Grid>
              <TextBlock Text="VISUAL" Style="{StaticResource Section}"/>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="88"/><ColumnDefinition Width="*"/><ColumnDefinition Width="45"/></Grid.ColumnDefinitions><TextBlock Text="Opacity" Style="{StaticResource Hint}"/><Slider Grid.Column="1" Minimum=".35" Maximum="1" Value="{Binding Opacity}"/><TextBlock Grid.Column="2" Text="{Binding Opacity, StringFormat={}{0:P0}}" HorizontalAlignment="Right" Style="{StaticResource Hint}"/></Grid>
              <WrapPanel Margin="0,4,0,0"><CheckBox Content="Header" IsChecked="{Binding ShowHeader}" Margin="0,5,18,0"/><CheckBox Content="Compact mode" IsChecked="{Binding Compact}" Margin="0,5,18,0"/></WrapPanel>
              <StackPanel Visibility="{Binding IsTimingWidget, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="DRIVER TABLE" Style="{StaticResource Section}"/>
                <WrapPanel><CheckBox Content="Bandeiras" IsChecked="{Binding ShowFlags}" Margin="0,5,18,0"/><CheckBox Content="Emblemas" IsChecked="{Binding ShowLogos}" Margin="0,5,18,0"/><CheckBox Content="Coluna P2P" IsChecked="{Binding ShowP2PColumn}" Margin="0,5,18,0"/></WrapPanel>
                <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="88"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Name" Style="{StaticResource Hint}"/><ComboBox Grid.Column="1" SelectedValue="{Binding DriverNameStyle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content"><ComboBoxItem Content="Abbreviated"/><ComboBoxItem Content="Full"/><ComboBoxItem Content="Code"/></ComboBox><TextBlock Grid.Column="2" Text="V. Costa · Vitor Costa · COS" Style="{StaticResource Hint}" Margin="9,0,0,0"/></Grid>
                <TextBlock Text="MULTICLASSE" Style="{StaticResource Section}"/><CheckBox Content="Exibir outras classes" IsChecked="{Binding ShowMulticlass}" Margin="0,2,0,5"/>
                <Grid Visibility="{Binding IsStandings, Converter={StaticResource BoolToVisibility}}"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Top fixo (líderes)" Style="{StaticResource Hint}"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="−" Width="28" Padding="2" Command="{Binding DataContext.DecreaseTopNCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/><TextBlock Text="{Binding TopNFixed}" Width="30" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/><Button Content="+" Width="28" Padding="2" Command="{Binding DataContext.IncreaseTopNCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/></StackPanel><TextBlock Grid.Column="2" Text="ex: P1-P2 sempre visíveis" Style="{StaticResource Hint}" Margin="10,0,0,0"/></Grid>
                <Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Linhas da minha classe" Style="{StaticResource Hint}"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="−" Width="28" Padding="2" Command="{Binding DataContext.DecreasePlayerRowsCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/><TextBlock Text="{Binding PlayerClassRows}" Width="30" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/><Button Content="+" Width="28" Padding="2" Command="{Binding DataContext.IncreasePlayerRowsCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/></StackPanel><TextBlock Grid.Column="2" Text="inclui o seu carro" Style="{StaticResource Hint}" Margin="10,0,0,0"/></Grid><Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Linhas por outra classe" Style="{StaticResource Hint}"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="−" Width="28" Padding="2" Command="{Binding DataContext.DecreaseOtherRowsCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/><TextBlock Text="{Binding OtherClassRows}" Width="30" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/><Button Content="+" Width="28" Padding="2" Command="{Binding DataContext.IncreaseOtherRowsCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/></StackPanel><TextBlock Grid.Column="2" Text="por categoria" Style="{StaticResource Hint}" Margin="10,0,0,0"/></Grid>
                <TextBlock Text="CABEÇALHO" Style="{StaticResource Section}"/><TextBlock Text="Informações disponíveis no topo do widget. Marque e reordene sem alterar os dados da tabela." Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                <ItemsControl ItemsSource="{Binding HeaderFields}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions><CheckBox IsChecked="{Binding IsVisible}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding Label}" Style="{StaticResource Hint}"/><Button Grid.Column="2" Content="◀" Padding="5,2" Command="{Binding DataContext.MoveHeaderLeftCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/><Button Grid.Column="3" Content="▶" Padding="5,2" Command="{Binding DataContext.MoveHeaderRightCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
              </StackPanel>
              <StackPanel Visibility="{Binding IsTimingWidget, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="CAMPOS E ORDEM" Style="{StaticResource Section}"/>
                <CheckBox Content="Ajustar largura automaticamente pelas colunas" IsChecked="{Binding AutoFitToColumns}" Margin="0,2,0,5"/>
                <TextBlock Text="CASAS DECIMAIS" Style="{StaticResource Section}"/>
                <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="78"/><ColumnDefinition Width="*"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions><TextBlock Text="Gap" Style="{StaticResource Hint}"/><Slider Grid.Column="1" Minimum="0" Maximum="3" IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding GapDecimals}"/><TextBlock Grid.Column="2" Text="{Binding GapDecimals}" Style="{StaticResource Hint}" HorizontalAlignment="Right"/></Grid>
                <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="78"/><ColumnDefinition Width="*"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions><TextBlock Text="Interval" Style="{StaticResource Hint}"/><Slider Grid.Column="1" Minimum="0" Maximum="3" IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding IntervalDecimals}"/><TextBlock Grid.Column="2" Text="{Binding IntervalDecimals}" Style="{StaticResource Hint}" HorizontalAlignment="Right"/></Grid>
                <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="78"/><ColumnDefinition Width="*"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions><TextBlock Text="Δ Volta" Style="{StaticResource Hint}"/><Slider Grid.Column="1" Minimum="0" Maximum="3" IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding LapDeltaDecimals}"/><TextBlock Grid.Column="2" Text="{Binding LapDeltaDecimals}" Style="{StaticResource Hint}" HorizontalAlignment="Right"/></Grid>
                <TextBlock Text="FIXED COLUMN WIDTHS" Style="{StaticResource Section}"/>
                <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="78"/><ColumnDefinition Width="*"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions><TextBlock Text="Posição" Style="{StaticResource Hint}"/><Slider Grid.Column="1" Minimum="26" Maximum="90" Value="{Binding PositionColumnWidth}"/><TextBlock Grid.Column="2" Text="{Binding PositionColumnWidth, StringFormat={}{0:0}}" Style="{StaticResource Hint}" HorizontalAlignment="Right"/></Grid>
                <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="78"/><ColumnDefinition Width="*"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions><TextBlock Text="Carro" Style="{StaticResource Hint}"/><Slider Grid.Column="1" Minimum="34" Maximum="120" Value="{Binding CarNumberColumnWidth}"/><TextBlock Grid.Column="2" Text="{Binding CarNumberColumnWidth, StringFormat={}{0:0}}" Style="{StaticResource Hint}" HorizontalAlignment="Right"/></Grid>
                <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="78"/><ColumnDefinition Width="*"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions><TextBlock Text="Piloto" Style="{StaticResource Hint}"/><Slider Grid.Column="1" Minimum="90" Maximum="360" Value="{Binding DriverColumnWidth}"/><TextBlock Grid.Column="2" Text="{Binding DriverColumnWidth, StringFormat={}{0:0}}" Style="{StaticResource Hint}" HorizontalAlignment="Right"/></Grid>
                <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="78"/><ColumnDefinition Width="*"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions><TextBlock Text="Licença" Style="{StaticResource Hint}"/><Slider Grid.Column="1" Minimum="42" Maximum="120" Value="{Binding LicenseColumnWidth}"/><TextBlock Grid.Column="2" Text="{Binding LicenseColumnWidth, StringFormat={}{0:0}}" Style="{StaticResource Hint}" HorizontalAlignment="Right"/></Grid>
                <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="78"/><ColumnDefinition Width="*"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions><TextBlock Text="iRating" Style="{StaticResource Hint}"/><Slider Grid.Column="1" Minimum="60" Maximum="170" Value="{Binding IRatingColumnWidth}"/><TextBlock Grid.Column="2" Text="{Binding IRatingColumnWidth, StringFormat={}{0:0}}" Style="{StaticResource Hint}" HorizontalAlignment="Right"/></Grid>
                <TextBlock Text="Marque, redimensione e use as setas para definir a ordem da esquerda para a direita." Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                <ItemsControl ItemsSource="{Binding TimingColumns}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition Width="78"/><ColumnDefinition Width="*"/><ColumnDefinition Width="35"/><ColumnDefinition Width="40"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions><CheckBox IsChecked="{Binding IsVisible}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding Label}" Style="{StaticResource Hint}"/><Slider Grid.Column="2" Minimum="34" Maximum="180" Value="{Binding Width}"/><TextBlock Grid.Column="3" Text="{Binding Width, StringFormat={}{0:0}}" Style="{StaticResource Hint}" HorizontalAlignment="Right"/><Button Grid.Column="4" Content="◀" Padding="5,2" Command="{Binding DataContext.MoveColumnLeftCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/><Button Grid.Column="5" Content="▶" Padding="5,2" Command="{Binding DataContext.MoveColumnRightCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
              </StackPanel>
              <StackPanel Visibility="{Binding IsRadar, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="RADAR ESPACIAL" Style="{StaticResource Section}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="88"/><ColumnDefinition Width="68"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Alcance" Style="{StaticResource Hint}"/><TextBox Grid.Column="1" Text="{Binding RadarRange, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Grid.Column="2" Text="metros ao redor" Style="{StaticResource Hint}" Margin="10,0,0,0"/></Grid></StackPanel>
              <StackPanel Visibility="{Binding IsStartHelper, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="START HELPER" Style="{StaticResource Section}"/><TextBlock Text="Shows clutch and throttle live at 60 FPS during the start." Style="{StaticResource Hint}" TextWrapping="Wrap"/></StackPanel>
              <StackPanel Visibility="{Binding IsFuel, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="ESTRATÉGIA DE COMBUSTÍVEL" Style="{StaticResource Section}"/><TextBlock Text="Escolha os consumos que aparecem no cartão. O nível, abastecimento calculado e tanque restante continuam sempre disponíveis." Style="{StaticResource Hint}" TextWrapping="Wrap"/><WrapPanel Margin="0,6,0,0"><CheckBox Content="Última volta" IsChecked="{Binding ShowFuelLastLap}" Margin="0,4,14,0"/><CheckBox Content="5 voltas" IsChecked="{Binding ShowFuelFiveLap}" Margin="0,4,14,0"/><CheckBox Content="Máximo" IsChecked="{Binding ShowFuelMax}" Margin="0,4,14,0"/><CheckBox Content="Voltas no tanque" IsChecked="{Binding ShowFuelLaps}" Margin="0,4,14,0"/></WrapPanel></StackPanel>
            </StackPanel>
          </Expander>
        </DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</Window>
