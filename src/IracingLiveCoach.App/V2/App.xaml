<Application x:Class="IracingLiveCoach.V2.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Original visual system, tuned from the observed characteristics: translucent black,
             compact tabular data and restrained neon semantic colour. -->
        <SolidColorBrush x:Key="Ink" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="Muted" Color="#FF82909E"/>
        <SolidColorBrush x:Key="Surface" Color="#A6000000"/>
        <SolidColorBrush x:Key="Surface2" Color="#E30A0C0E"/>
        <SolidColorBrush x:Key="Accent" Color="#FF4DE95F"/>
        <SolidColorBrush x:Key="Danger" Color="#FFFF3C22"/>
        <SolidColorBrush x:Key="Warning" Color="#FFFFB84D"/>
        <SolidColorBrush x:Key="Cyan" Color="#FF33DAEC"/>
        <FontFamily x:Key="OverlayFont">pack://application:,,,/IracingLiveCoach.App;component/V2/Assets/Fonts/#Satoshi</FontFamily>
        <!-- Transparent WPF windows cannot render sub-pixel ClearType reliably.  Grayscale keeps
             Satoshi antialiased across every overlay instead of falling back to jagged glyphs. -->
        <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource OverlayFont}"/><Setter Property="FontWeight" Value="Medium"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Typography.NumeralAlignment" Value="Tabular"/><Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/><Setter Property="TextOptions.TextRenderingMode" Value="Grayscale"/><Setter Property="TextOptions.TextHintingMode" Value="Animated"/></Style>
        <!-- Widget typography scale: labels 700, live values 500, key numbers 700 and titles 900. -->
        <Style x:Key="WidgetLabel" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource OverlayFont}"/><Setter Property="FontSize" Value="8.5"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="#FFD6E0EA"/><Setter Property="Typography.NumeralAlignment" Value="Tabular"/></Style>
        <Style x:Key="WidgetValue" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource OverlayFont}"/><Setter Property="FontSize" Value="10.5"/><Setter Property="FontWeight" Value="Medium"/><Setter Property="Foreground" Value="#FFF4F7FA"/><Setter Property="Typography.NumeralAlignment" Value="Tabular"/></Style>
        <Style x:Key="WidgetNumber" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource OverlayFont}"/><Setter Property="FontSize" Value="10"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="#FFF9FCFF"/><Setter Property="Typography.NumeralAlignment" Value="Tabular"/></Style>
        <Style x:Key="WidgetTitle" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource OverlayFont}"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="Black"/><Setter Property="Foreground" Value="#FFF9FCFF"/></Style>
        <Style TargetType="Button"><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Background" Value="#CC121416"/><Setter Property="BorderBrush" Value="#FF4DE95F"/><Setter Property="Padding" Value="10,6"/><Setter Property="Margin" Value="2"/></Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Margin" Value="0,3"/></Style>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </Application.Resources>
</Application>
