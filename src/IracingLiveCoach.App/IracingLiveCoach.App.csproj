<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- UseWindowsForms: only for System.Windows.Forms.NotifyIcon (the system tray icon used to
         lock/unlock the overlay for repositioning); WPF has no tray-icon API of its own. -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- V2 deliberately compiles only its clean architecture.  Legacy V1 files remain in Git
         history for traceability but are no longer part of the executable. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\IracingLiveCoach.Core\IracingLiveCoach.Core.csproj" />
    <PackageReference Include="IRSDKSharper" Version="1.3.0" />
    <!-- Open-source Material Design Icons pack (Apache-2.0); used for neutral telemetry symbols. -->
    <PackageReference Include="MahApps.Metro.IconPacks.Material" Version="5.1.0" />
    <!-- MIT-licensed SVG renderer used with the MIT Cardog automotive icon collection. -->
    <PackageReference Include="SharpVectors.Wpf" Version="1.8.6" />
    <ApplicationDefinition Include="V2\App.xaml" />
    <Page Include="V2\MainWindow.xaml" />
    <Page Include="V2\StudioWindow.xaml" />
    <!-- Satoshi is obtained directly from Fontshare under the ITF Free Font License. -->
    <Resource Include="V2\Assets\Fonts\Satoshi-Regular.ttf" />
    <Resource Include="V2\Assets\Fonts\Satoshi-Medium.ttf" />
    <Resource Include="V2\Assets\Fonts\Satoshi-Bold.ttf" />
    <Resource Include="V2\Assets\Fonts\Satoshi-Black.ttf" />
    <Resource Include="Assets\Flags\*.png" />
    <Resource Include="Assets\Brands\*.png" />
    <Resource Include="Assets\Brands\Vector\*.svg" />
    <Compile Include="V2\**\*.cs" />
    <Compile Include="TelemetryReader.cs" />
  </ItemGroup>

</Project>
