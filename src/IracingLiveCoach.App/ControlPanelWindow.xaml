<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="IracingLiveCoach.App.ControlPanelWindow" Title="Painel de Controle" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True" ShowInTaskbar="False" MinWidth="420" MinHeight="420" SizeToContent="Manual" UseLayoutRounding="True" FontFamily="{StaticResource F1MonoFont}">
    <Grid Background="Transparent" MouseLeftButtonDown="OnBackgroundMouseLeftButtonDown">
        <Border BorderBrush="{StaticResource F1SeparatorBrush}" BorderThickness="1" Background="{StaticResource F1BackgroundBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Background="{StaticResource F1AccentBrush}"/>
                <StackPanel Grid.Row="1" Margin="22,20,22,18">
                    <TextBlock Text="LIVE COACH  /  CONFIGURAÇÕES" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource F1HighlightBrush}"/>
                    <TextBlock Text="Seu cockpit. Seu controle." FontFamily="{StaticResource F1HeaderFont}" FontSize="30" FontWeight="Bold" Foreground="White" Margin="0,4,0,5"/>
                    <TextBlock Text="Ative os overlays e ajuste a leitura durante a corrida." FontSize="11" Foreground="{StaticResource F1MutedTextBrush}" TextWrapping="Wrap"/>
                </StackPanel>
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="22,0,22,16">
                        <TextBlock Text="OVERLAYS" Style="{StaticResource HeaderCell}" Margin="0,0,0,10"/>
                        <ItemsControl ItemsSource="{Binding Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FF101B24" BorderBrush="{StaticResource F1SeparatorBrush}" BorderThickness="1" Padding="14,9" Margin="0,0,0,7" CornerRadius="3">
                                        <StackPanel>
                                            <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding Visible, Mode=TwoWay}" Style="{StaticResource ControlToggle}" Margin="0,2"/>
                                            <Grid Margin="0,7,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="44"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="OPACIDADE" Style="{StaticResource FooterLabel}" VerticalAlignment="Center"/>
                                                <Slider Grid.Column="1" Minimum="0.25" Maximum="1" Value="{Binding Opacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ControlSlider}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Opacity, StringFormat={}{0:P0}}" Style="{StaticResource FooterLabel}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Margin="0,18,0,0">
                            <TextBlock Text="FUEL · CAMPOS" Style="{StaticResource HeaderCell}" Margin="0,0,0,8"/>
                            <StackPanel Margin="0">
                                <CheckBox Content="Nível" IsChecked="{Binding FuelColumns.Level, Mode=TwoWay}" Foreground="{StaticResource F1TextBrush}" Margin="0,2" Style="{StaticResource ControlToggle}"/>
                                <CheckBox Content="Consumo/h" IsChecked="{Binding FuelColumns.UsePerHour, Mode=TwoWay}" Foreground="{StaticResource F1TextBrush}" Margin="0,2" Style="{StaticResource ControlToggle}"/>
                                <CheckBox Content="Média/volta" IsChecked="{Binding FuelColumns.AveragePerLap, Mode=TwoWay}" Foreground="{StaticResource F1TextBrush}" Margin="0,2" Style="{StaticResource ControlToggle}"/>
                                <CheckBox Content="Voltas" IsChecked="{Binding FuelColumns.LapsRemaining, Mode=TwoWay}" Foreground="{StaticResource F1TextBrush}" Margin="0,2" Style="{StaticResource ControlToggle}"/>
                                <CheckBox Content="Tempo" IsChecked="{Binding FuelColumns.TimeRemaining, Mode=TwoWay}" Foreground="{StaticResource F1TextBrush}" Margin="0,2" Style="{StaticResource ControlToggle}"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Margin="0,18,0,0">
                            <TextBlock Text="STANDINGS • CLASSES" Style="{StaticResource HeaderCell}" Margin="0,0,0,8"/>
                            <StackPanel Margin="0">
                                <TextBlock Text="Linhas da minha classe (0 = todas)" FontSize="10" Foreground="{StaticResource F1MutedTextBrush}" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding StandingsClassRows.MyClassRows, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" Width="86" HorizontalAlignment="Left" Margin="0,0,0,6" Style="{StaticResource ControlInput}"/>
                                <TextBlock Text="Linhas por outra classe (0 = todas)" FontSize="10" Foreground="{StaticResource F1MutedTextBrush}" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding StandingsClassRows.OtherClassRows, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" Width="86" HorizontalAlignment="Left" Margin="0,0,0,6" Style="{StaticResource ControlInput}"/>
                                <CheckBox Content="Intervalo para o carro à frente" IsChecked="{Binding StandingsClassRows.ShowInterval, Mode=TwoWay}" Foreground="{StaticResource F1TextBrush}" FontSize="10" Style="{StaticResource ControlToggle}" Margin="0,2"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
                <Border Grid.Row="3" Padding="22,12" BorderBrush="{StaticResource F1SeparatorBrush}" BorderThickness="0,1,0,0">
                    <TextBlock Text="Arraste para posicionar • Trave pelo ícone na bandeja" FontSize="10" Foreground="{StaticResource F1MutedTextBrush}" TextWrapping="Wrap"/>
                </Border>
            </Grid>
        </Border>
        <Thumb x:Name="ResizeGrip" Width="14" Height="14" Cursor="SizeNWSE" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="{StaticResource F1AccentBrush}" Opacity="0.5" DragDelta="OnResizeGripDragDelta" DragCompleted="OnResizeGripDragCompleted"/>
    </Grid>
</Window>
