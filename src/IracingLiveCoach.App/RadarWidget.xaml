<Window x:Class="IracingLiveCoach.App.RadarWidget" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Radar" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True" ShowInTaskbar="False" MinWidth="150" MinHeight="150" SizeToContent="Manual"><Grid Background="Transparent" MouseLeftButtonDown="OnBackgroundMouseLeftButtonDown"><Viewbox Stretch="Uniform"><Canvas Width="180" Height="180" Visibility="{Binding HasProximity, Converter={StaticResource BoolToVisibilityConverter}}"><Ellipse Canvas.Left="5" Canvas.Top="5" Width="170" Height="170" Fill="#1608131E" Stroke="#80536A78" StrokeThickness="1"/><Ellipse Canvas.Left="45" Canvas.Top="45" Width="90" Height="90" Fill="Transparent" Stroke="#45536A78" StrokeThickness="1" StrokeDashArray="3,3"/><Line X1="90" Y1="12" X2="90" Y2="168" Stroke="#55536A78" StrokeDashArray="3,3"/><Line X1="12" Y1="90" X2="168" Y2="90" Stroke="#55536A78" StrokeDashArray="3,3"/><ItemsControl ItemsSource="{Binding Blips}" Canvas.Left="0" Canvas.Top="0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas Width="180" Height="180"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Ellipse Width="14" Height="14" Fill="#FFFFB000" Stroke="White" StrokeThickness="1" ToolTip="{Binding ToolTip}"><Ellipse.RenderTransform><TranslateTransform X="83" Y="{Binding Top}"/></Ellipse.RenderTransform></Ellipse></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Rectangle Canvas.Left="78" Canvas.Top="78" Width="24" Height="24" RadiusX="4" RadiusY="4" Fill="#FF19D6E2" Stroke="White" StrokeThickness="1"/><TextBlock Text="YOU" Canvas.Left="82" Canvas.Top="84" FontFamily="{StaticResource F1MonoFont}" FontSize="7" Foreground="#08131D"/><Ellipse Canvas.Left="35" Canvas.Top="83" Width="18" Height="18" Fill="#FFFF3548" Visibility="{Binding BlindLeft, Converter={StaticResource BoolToVisibilityConverter}}"/><Ellipse Canvas.Left="127" Canvas.Top="83" Width="18" Height="18" Fill="#FFFF3548" Visibility="{Binding BlindRight, Converter={StaticResource BoolToVisibilityConverter}}"/></Canvas></Viewbox><Thumb x:Name="ResizeGrip" Width="12" Height="12" Cursor="SizeNWSE" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="#80E2483D" DragDelta="OnResizeGripDragDelta" DragCompleted="OnResizeGripDragCompleted"/></Grid></Window>
