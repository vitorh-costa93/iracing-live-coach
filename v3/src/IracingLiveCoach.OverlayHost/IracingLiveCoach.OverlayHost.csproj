<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\IracingLiveCoach.Core\IracingLiveCoach.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Vortice.Win32.Graphics.Direct3D11" Version="2.5.0" />
    <PackageReference Include="Vortice.Win32.Graphics.Dxgi" Version="2.5.0" />
    <PackageReference Include="Vortice.Win32.Graphics.Direct2D" Version="2.5.0" />
    <PackageReference Include="Vortice.Win32.Graphics.DirectWrite" Version="2.5.0" />
    <PackageReference Include="Vortice.Win32.Graphics.DirectComposition" Version="2.5.0" />
    <PackageReference Include="Vortice.Win32.Graphics.Imaging" Version="2.5.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Same physical files as src/IracingLiveCoach.App/Assets/Flags; copied, not re-authored,
         because V2 and V3 are separately deployed executables and each needs its own copy in its
         own output directory (V2 embeds them as WPF pack resources; this project just needs them
         on disk next to the exe). See spec section 18: reuse existing assets, no parallel catalog. -->
    <Content Include="Assets\Flags\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Brands\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Fonts\*.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
