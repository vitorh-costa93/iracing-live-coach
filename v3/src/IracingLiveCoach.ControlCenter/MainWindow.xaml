<Window x:Class="IracingLiveCoach.ControlCenter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Live Coach · Overlay Studio" Width="1180" Height="760"
        Background="#0B1118" Foreground="#F2F5F7">
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
            <TextBlock Text="OVERLAY STUDIO" FontSize="22" FontWeight="Bold"/>
            <TextBlock Text="Live Coach V3" Margin="0,2,0,20" Foreground="#A6B0BB" FontSize="11"/>
            <Button Content="Standings" Tag="standings" Click="SelectWidget" Margin="0,0,0,4"/>
            <Button Content="Relative" Tag="relative" Click="SelectWidget" Margin="0,0,0,4"/>
            <Button Content="Weather" Tag="weather" Click="SelectWidget" Margin="0,0,0,4"/>
            <Button Content="Fuel" Tag="fuel" Click="SelectWidget" Margin="0,0,0,4"/>
            <Button Content="Radar" Tag="radar" Click="SelectWidget" Margin="0,0,0,4"/>
            <Button Content="Start Helper" Tag="start-helper" Click="SelectWidget"/>

            <TextBlock Text="MODO DE EDIÇÃO" FontWeight="Bold" Foreground="#69DDEC" Margin="0,24,0,6" FontSize="11"/>
            <TextBlock Text="Travado: overlays só aparecem na pista. Destravado: aparecem sempre, para você posicionar." Foreground="#73808C" FontSize="9" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <Button x:Name="EditModeButton" Content="Destravar para editar" Click="ToggleEditMode"/>
            <TextBlock x:Name="EditModeStatus" Text="" Foreground="#A6B0BB" FontSize="10" Margin="0,6,0,0" TextWrapping="Wrap"/>

            <TextBlock Text="HISTÓRICO" FontWeight="Bold" Foreground="#69DDEC" Margin="0,20,0,6" FontSize="11"/>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="UndoButton" Content="Desfazer" Click="UndoPlacement" Margin="0,0,6,0"/>
                <Button x:Name="RedoButton" Content="Refazer" Click="RedoPlacement"/>
            </StackPanel>

            <TextBlock x:Name="ConnectionStatus" Text="" Margin="0,20,0,0" Foreground="#A6B0BB" FontSize="11" TextWrapping="Wrap"/>
        </StackPanel>

        <ScrollViewer Grid.Column="1" Margin="28,0,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <TextBlock x:Name="WidgetTitle" Text="STANDINGS" FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="Changes are sent immediately to the running overlay — no restart." Margin="0,6,0,12" Foreground="#A6B0BB"/>

            <TextBlock Text="PREVIEW AO VIVO · 1920×1080" FontWeight="Bold" Foreground="#69DDEC" Margin="0,0,0,8"/>
            <TextBlock Text="Esta é uma prévia visual real (mesmo renderer D2D do overlay), com dados fictícios de simulação -- disponível mesmo sem o iRacing aberto." Foreground="#73808C" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,6"/>
            <Border x:Name="PreviewBorder" BorderBrush="#405A6B" BorderThickness="1" Background="#0B1219" Height="260" MaxWidth="640" HorizontalAlignment="Stretch" SizeChanged="PreviewBorder_AspectSizeChanged"/>

            <TabControl Margin="0,20,0,0" Background="Transparent" BorderThickness="0">
                <TabItem Header="Layout">
                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="POSITION &amp; SIZE" FontWeight="Bold" Foreground="#69DDEC" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="X" Foreground="#A6B0BB" FontSize="11"/>
                                <TextBox x:Name="XBox" TextChanged="PositionChanged" Background="#17232E" Foreground="#F2F5F7" BorderBrush="#405A6B" Padding="4"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,6,0">
                                <TextBlock Text="Y" Foreground="#A6B0BB" FontSize="11"/>
                                <TextBox x:Name="YBox" TextChanged="PositionChanged" Background="#17232E" Foreground="#F2F5F7" BorderBrush="#405A6B" Padding="4"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,6,0">
                                <TextBlock Text="Width" Foreground="#A6B0BB" FontSize="11"/>
                                <TextBox x:Name="WidthBox" TextChanged="PositionChanged" Background="#17232E" Foreground="#F2F5F7" BorderBrush="#405A6B" Padding="4"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="Height" Foreground="#A6B0BB" FontSize="11"/>
                                <TextBox x:Name="HeightBox" TextChanged="PositionChanged" Background="#17232E" Foreground="#F2F5F7" BorderBrush="#405A6B" Padding="4"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="VISIBILITY &amp; LOCK" FontWeight="Bold" Foreground="#69DDEC" Margin="0,0,0,8"/>
                        <CheckBox x:Name="VisibleBox" Content="Visible" IsChecked="True" Checked="ToggleChanged" Unchecked="ToggleChanged" Margin="0,0,0,4"/>
                        <CheckBox x:Name="LockedBox" Content="Lock (prevent drag/resize in-game)" Checked="ToggleChanged" Unchecked="ToggleChanged" Margin="0,0,0,16"/>

                        <TextBlock Text="OPACITY" Foreground="#A6B0BB" Margin="0,0,0,4"/>
                        <Slider x:Name="OpacitySlider" Minimum="0.2" Maximum="1" Value="1" ValueChanged="SliderChanged" Margin="0,0,0,16"/>

                        <TextBlock Text="SCALE" Foreground="#A6B0BB" Margin="0,0,0,4"/>
                        <Slider x:Name="ScaleSlider" Minimum="0.5" Maximum="1.5" Value="1" ValueChanged="SliderChanged" Margin="0,0,0,16"/>

                        <TextBlock Text="APARÊNCIA" FontWeight="Bold" Foreground="#69DDEC" Margin="0,0,0,4"/>
                        <TextBlock Text="Tamanho de fonte, altura das linhas e espaçamento entre linhas -- aplicado ao vivo. Altura/espaçamento só afetam Standings e Relative (widgets de tabela)." Foreground="#73808C" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <TextBlock Text="Tamanho de fonte" Foreground="#A6B0BB" Margin="0,0,0,4"/>
                        <Slider x:Name="FontScaleSlider" Minimum="0.7" Maximum="1.6" Value="1" ValueChanged="AppearanceSliderChanged" Margin="0,0,0,12"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="Altura da linha (px, 0 = padrão)" Foreground="#A6B0BB" FontSize="11"/>
                                <TextBox x:Name="RowHeightBox" Text="0" Background="#17232E" Foreground="#F2F5F7" BorderBrush="#405A6B" Padding="4"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Espaçamento entre linhas (px)" Foreground="#A6B0BB" FontSize="11"/>
                                <TextBox x:Name="RowSpacingBox" Text="0" Background="#17232E" Foreground="#F2F5F7" BorderBrush="#405A6B" Padding="4"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Button Content="Aplicar" Click="ApplyAppearance" Margin="0,0,8,0"/>
                            <Button Content="Restaurar padrão" Click="RestoreDefaultAppearance"/>
                        </StackPanel>
                        <TextBlock x:Name="AppearanceStatus" Text="" Foreground="#A6B0BB" FontSize="11" Margin="0,0,0,16" TextWrapping="Wrap"/>

                        <TextBlock Text="RESTAURAR POSIÇÃO/TAMANHO" FontWeight="Bold" Foreground="#69DDEC" Margin="0,0,0,4"/>
                        <TextBlock Text="Volta este widget à posição, tamanho, opacidade e escala padrão -- não afeta os demais widgets." Foreground="#73808C" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <Button Content="Restaurar padrão do widget" Click="RestoreDefaultPlacement" HorizontalAlignment="Left"/>
                    </StackPanel>
                </TabItem>

                <TabItem Header="Colunas">
                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="COLUNAS" FontWeight="Bold" Foreground="#69DDEC" Margin="0,0,0,4"/>
                        <TextBlock x:Name="ColumnsHint" Text="Reordenar (↑/↓), largura, casas decimais, alinhamento e visibilidade -- aplicado ao vivo. Disponível para Standings e Relative." Foreground="#73808C" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <ItemsControl x:Name="ColumnList"/>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="Aplicar" Click="ApplyColumnConfig" Margin="0,0,8,0"/>
                            <Button Content="Restaurar padrão" Click="RestoreDefaultColumns"/>
                        </StackPanel>
                        <TextBlock x:Name="ColumnsStatus" Text="" Foreground="#A6B0BB" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </TabItem>

                <TabItem Header="Regras">
                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="REGRAS -- STANDINGS" FontWeight="Bold" Foreground="#69DDEC" Margin="0,0,0,4"/>
                        <TextBlock Text="Top N fixo por classe, linhas da minha classe, linhas de outras classes, e se mantém a janela em torno do jogador -- sem duplicar pilotos já exibidos." Foreground="#73808C" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="Top N por classe" Foreground="#A6B0BB" FontSize="11"/>
                                <TextBox x:Name="TopNBox" Text="1" Background="#17232E" Foreground="#F2F5F7" BorderBrush="#405A6B" Padding="4"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,6,0">
                                <TextBlock Text="Linhas da minha classe" Foreground="#A6B0BB" FontSize="11"/>
                                <TextBox x:Name="OwnClassRowsBox" Text="5" Background="#17232E" Foreground="#F2F5F7" BorderBrush="#405A6B" Padding="4"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Linhas de outras classes" Foreground="#A6B0BB" FontSize="11"/>
                                <TextBox x:Name="OtherClassRowsBox" Text="1" Background="#17232E" Foreground="#F2F5F7" BorderBrush="#405A6B" Padding="4"/>
                            </StackPanel>
                        </Grid>
                        <CheckBox x:Name="KeepPlayerWindowBox" Content="Manter janela em torno do jogador" IsChecked="True" Margin="0,0,0,12"/>
                        <Button Content="Aplicar" Click="ApplyRules" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="RulesStatus" Text="" Foreground="#A6B0BB" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"/>

                        <TextBlock Text="REGRAS -- COMBUSTÍVEL" FontWeight="Bold" Foreground="#69DDEC" Margin="0,24,0,4"/>
                        <TextBlock Text="Qual consumo dita a autonomia/tempo exibidos, margem de reserva em voltas, e se exclui a volta de pit do cálculo (a média/máximo já sempre excluem; isto controla se 'última volta' cai de volta pra média quando a última foi afetada pelo pit)." Foreground="#73808C" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="Fonte do consumo" Foreground="#A6B0BB" FontSize="11"/>
                                <ComboBox x:Name="FuelSourceBox" SelectedIndex="1">
                                    <ComboBoxItem Content="Última volta"/>
                                    <ComboBoxItem Content="Média móvel"/>
                                    <ComboBoxItem Content="Máximo"/>
                                    <ComboBoxItem Content="Manual"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,6,0">
                                <TextBlock Text="Valor manual (L/volta)" Foreground="#A6B0BB" FontSize="11"/>
                                <TextBox x:Name="FuelManualBox" Text="0" Background="#17232E" Foreground="#F2F5F7" BorderBrush="#405A6B" Padding="4"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Reserva (voltas)" Foreground="#A6B0BB" FontSize="11"/>
                                <TextBox x:Name="FuelReserveBox" Text="1.0" Background="#17232E" Foreground="#F2F5F7" BorderBrush="#405A6B" Padding="4"/>
                            </StackPanel>
                        </Grid>
                        <CheckBox x:Name="FuelExcludePitBox" Content="Excluir volta de pit ao usar 'última volta'" IsChecked="True" Margin="0,0,0,12"/>
                        <Button Content="Aplicar" Click="ApplyFuelConfig" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="FuelRulesStatus" Text="" Foreground="#A6B0BB" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </TabItem>

                <TabItem Header="Cores">
                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="CORES POR CLASSE" FontWeight="Bold" Foreground="#69DDEC" Margin="0,0,0,4"/>
                        <TextBlock Text="Sobrescreve a cor normativa (spec §16) para uma classe pelo nome curto (ex: GT3, GTP, SF23). Aplica-se à faixa de posição e ao cabeçalho de classe em Standings e Relative, ao vivo." Foreground="#73808C" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <ItemsControl x:Name="ClassColorList"/>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <TextBox x:Name="NewClassNameBox" Width="80" Background="#17232E" Foreground="#F2F5F7" BorderBrush="#405A6B" Padding="4" Margin="0,0,6,0"/>
                            <TextBox x:Name="NewClassColorBox" Width="90" Text="#FFD400" Background="#17232E" Foreground="#F2F5F7" BorderBrush="#405A6B" Padding="4" Margin="0,0,6,0"/>
                            <Button Content="Adicionar / Atualizar" Click="AddClassColorOverride"/>
                        </StackPanel>
                        <TextBlock x:Name="ColorStatus" Text="" Foreground="#A6B0BB" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </TabItem>

                <TabItem Header="Perfis">
                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="PERFIS" FontWeight="Bold" Foreground="#69DDEC" Margin="0,0,0,4"/>
                        <TextBlock Text="Exporta/importa o layout salvo (v3-layout.json): posições, tamanhos, visibilidade e cores de classe de todos os widgets." Foreground="#73808C" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Exportar perfil..." Click="ExportProfile" Margin="0,0,8,0"/>
                            <Button Content="Importar perfil..." Click="ImportProfile" Margin="0,0,8,0"/>
                            <Button Content="Restaurar cores padrão" Click="RestoreDefaults"/>
                        </StackPanel>
                        <TextBlock x:Name="ProfileStatus" Text="" Foreground="#A6B0BB" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
