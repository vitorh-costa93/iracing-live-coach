<Window x:Class="IracingLiveCoach.ControlCenter.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Live Coach · Overlay Studio" Width="720" Height="540" Background="#0B1118" Foreground="#F2F5F7"><Grid Margin="24"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="OVERLAY STUDIO" FontSize="22" FontWeight="Bold"/><Button Content="Standings" Tag="standings" Click="SelectWidget" Margin="0,24,0,4"/><Button Content="Relative" Tag="relative" Click="SelectWidget" Margin="0,0,0,4"/><Button Content="Weather" Tag="weather" Click="SelectWidget" Margin="0,0,0,4"/><Button Content="Fuel" Tag="fuel" Click="SelectWidget" Margin="0,0,0,4"/><Button Content="Radar" Tag="radar" Click="SelectWidget" Margin="0,0,0,4"/><Button Content="Start Helper" Tag="start-helper" Click="SelectWidget"/></StackPanel><StackPanel Grid.Column="1" Margin="28,0,0,0"><TextBlock x:Name="Title" Text="STANDINGS" FontSize="20" FontWeight="Bold"/><TextBlock Text="Live configuration" Margin="0,6,0,20" Foreground="#A6B0BB"/><CheckBox x:Name="Visible" Content="Visible" IsChecked="True" Checked="Changed" Unchecked="Changed"/><CheckBox x:Name="Locked" Content="Lock overlay" Margin="0,8,0,0" Checked="Changed" Unchecked="Changed"/><TextBlock Text="Opacity" Margin="0,24,0,4"/><Slider x:Name="Opacity" Minimum="0.2" Maximum="1" Value="1" ValueChanged="Changed"/><TextBlock Text="Scale" Margin="0,16,0,4"/><Slider x:Name="Scale" Minimum="0.5" Maximum="1.5" Value="1" ValueChanged="Changed"/><TextBlock Text="Changes are sent immediately to the running overlay." Margin="0,30,0,0" Foreground="#A6B0BB"/></StackPanel></Grid></Window>
