<Window x:Class="Ams2.ControlCenter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Ams2.ControlCenter"
        Title="AMS2 Live Coach - Control Center" Icon="pack://application:,,,/Assets/ams2-live-coach.ico" Width="1100" Height="700" MinWidth="980" MinHeight="620"
        Background="{StaticResource BgBrush}" FontFamily="{StaticResource UiFont}" WindowStartupLocation="CenterScreen"
        Topmost="True" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <!-- Numero inline da frase (segundos, linhas): caixa pequena, valida/limita no ShowNumVm -->
        <DataTemplate x:Key="ChoiceItem"><TextBlock Text="{Binding Label}"/></DataTemplate>
        <DataTemplate x:Key="InlineNum">
            <TextBox Width="54" Padding="4,3" TextAlignment="Center" Margin="2,0,4,0" ToolTip="{Binding Range}"
                     Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
        </DataTemplate>
        <Style x:Key="Word" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="2,0,2,0"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style x:Key="Chip" TargetType="ToggleButton" BasedOn="{StaticResource ToggleButtonStyle}">
            <Setter Property="Padding" Value="9,3"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="TabButton" TargetType="ToggleButton" BasedOn="{StaticResource ToggleButtonStyle}">
            <Setter Property="Padding" Value="18,7"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== Cabecalho ===== -->
        <Border Grid.Row="0" Padding="24,16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Background="{StaticResource PanelBrush}">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/ams2-live-coach.png" Width="30" Height="30" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="AMS2 Live Coach" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock Text="Control Center" Style="{StaticResource Muted}" FontSize="14" Margin="10,2,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="{StaticResource RaisedBrush}" CornerRadius="12" Padding="10,4" Margin="0,0,8,0" ToolTip="Conexão com o processo do overlay (OverlayHost)">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="HostDot" Width="8" Height="8" Fill="{StaticResource OffBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="HostText" Text="Overlay: desconectado" Margin="8,0,0,0" FontSize="12"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource RaisedBrush}" CornerRadius="12" Padding="10,4" Margin="0,0,16,0" ToolTip="Dados do jogo (memória compartilhada do AMS2)">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="GameDot" Width="8" Height="8" Fill="{StaticResource OffBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="GameText" Text="AMS2: sem dados" Margin="8,0,0,0" FontSize="12"/>
                        </StackPanel>
                    </Border>
                    <ToggleButton x:Name="NamesToggle" Style="{StaticResource ToggleButtonStyle}" Content="Piloto e pintura" Margin="0,0,8,0" Click="NamesToggle_Click"
                                  ToolTip="Nome de exibição do seu carro nos widgets, um por modelo de carro (o jogo usa o nome do perfil)."/>
                    <ToggleButton x:Name="VictoryToggle" Style="{StaticResource ToggleButtonStyle}" Content="Tema da vitória" Margin="0,0,8,0" Click="VictoryToggle_Click"
                                  ToolTip="Toca um áudio seu quando você vence uma corrida. O tema é escolhido pelo nome do piloto (Senna, Barrichello, Massa; outro nome = Padrão)."/>
                    <ToggleButton x:Name="EditToggle" Style="{StaticResource ToggleButtonStyle}" Content="Editar layout" Click="EditToggle_Click"
                                  ToolTip="Torna as janelas arrastáveis: arraste para mover (grade/encaixe, Alt desliga), roda do mouse ou canto inferior direito para a escala. Atalho no jogo: Ctrl+Alt+E."/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Aviso: perfil em edicao nao e o ativo -->
        <Border x:Name="InactiveBanner" Grid.Row="1" Visibility="Collapsed" Background="#2A2412" BorderBrush="#4A3F1A" BorderThickness="0,0,0,1" Padding="24,8">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Ativar agora" Padding="10,3" Click="Activate_Click"/>
                <TextBlock x:Name="InactiveText" Foreground="{StaticResource WarnBrush}" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- ===== Tema e perfis ===== -->
            <Border Grid.Column="0" Grid.RowSpan="2" Style="{StaticResource Card}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="TEMA" Style="{StaticResource SectionTitle}"/>
                        <ComboBox x:Name="ThemeCombo" Height="32" SelectionChanged="ThemeCombo_SelectionChanged" DisplayMemberPath="Label">
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                    <Setter Property="IsEnabled" Value="{Binding IsAvailable}"/>
                                </Style>
                            </ComboBox.ItemContainerStyle>
                        </ComboBox>
                        <TextBlock Text="PERFIS" Style="{StaticResource SectionTitle}" Margin="0,22,0,8"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="6"/><RowDefinition/></Grid.RowDefinitions>
                            <Button Grid.Row="0" Grid.Column="0" Content="Novo" Click="NewProfile_Click"/>
                            <Button Grid.Row="0" Grid.Column="2" Content="Duplicar" Click="DuplicateProfile_Click"/>
                            <Button Grid.Row="2" Grid.Column="0" Content="Renomear" Click="RenameProfile_Click"/>
                            <Button Grid.Row="2" Grid.Column="2" Content="Excluir" Style="{StaticResource DangerButton}" Click="DeleteProfile_Click"/>
                        </Grid>
                        <Button x:Name="ActivateButton" Content="Ativar perfil" Style="{StaticResource PrimaryButton}" Margin="0,10,0,0" Click="Activate_Click"/>
                    </StackPanel>
                    <ListBox x:Name="ProfilesList" SelectionChanged="ProfilesList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="10,8">
                                    <Border DockPanel.Dock="Right" Background="{StaticResource AccentDimBrush}" CornerRadius="3" Padding="6,1" VerticalAlignment="Center"
                                            Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="ATIVO" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                                    </Border>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- ===== Abas principais: Telas e exibicao (padrao) | Avancado (lista antiga de widgets + detalhes) ===== -->
            <StackPanel Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,0,0,12">
                <ToggleButton x:Name="ViewScreens" Style="{StaticResource TabButton}" Content="Telas e exibição" IsChecked="True" Margin="0,0,8,0" Click="ViewScreens_Click"
                              ToolTip="Escolha o que aparece em cada situação do jogo, quando e por quanto tempo."/>
                <ToggleButton x:Name="ViewAdvanced" Style="{StaticResource TabButton}" Content="Avançado" Click="ViewAdvanced_Click"
                              ToolTip="Lista completa de widgets: posição, tamanho, fonte, cores, colunas e formatos."/>
            </StackPanel>

            <!-- ===== Telas e exibicao ===== -->
            <Border x:Name="ScreensView" Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="3" Style="{StaticResource Card}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Content="Restaurar padrão do tema (esta situação)" Style="{StaticResource LinkButton}" Click="ResetAllCards_Click"
                                ToolTip="Volta todos os cartões desta aba ao comportamento original do tema."/>
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton x:Name="TabPractice" Tag="practice" Style="{StaticResource TabButton}" Content="Treino" Margin="0,0,6,0" Click="SituationTab_Click"/>
                            <ToggleButton x:Name="TabQualify" Tag="qualify" Style="{StaticResource TabButton}" Content="Classificação" Margin="0,0,6,0" Click="SituationTab_Click"/>
                            <ToggleButton x:Name="TabRace" Tag="race" Style="{StaticResource TabButton}" Content="Corrida" IsChecked="True" Click="SituationTab_Click"/>
                        </StackPanel>
                    </DockPanel>
                    <TextBlock x:Name="ScreensHint" DockPanel.Dock="Top" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,12"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="CardsList" Margin="0,0,10,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,10" Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPiece}" Value="True"><Setter Property="Margin" Value="28,0,0,10"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Border Width="4" HorizontalAlignment="Left" CornerRadius="8,0,0,8" Background="{StaticResource WarnBrush}"
                                                    Visibility="{Binding IsModified, Converter={StaticResource BoolToVis}}" ToolTip="Alterado em relação ao padrão do tema"/>
                                            <Grid Margin="18,14,16,14">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="44" Height="44" CornerRadius="8" Background="{StaticResource BgBrush}" VerticalAlignment="Top" Margin="0,0,14,0">
                                                    <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource IconFont}" FontSize="20" Foreground="{StaticResource AccentBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1">
                                                    <!-- cabecalho -->
                                                    <DockPanel>
                                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                                            <Button Width="30" Padding="0,5" Margin="0,0,2,0" Click="CardUp_Click"
                                                                    Visibility="{Binding CanReorder, Converter={StaticResource BoolToVis}}" ToolTip="Subir (maior prioridade)">
                                                                <TextBlock Text="&#xE70E;" FontFamily="{StaticResource IconFont}" FontSize="12"/>
                                                            </Button>
                                                            <Button Width="30" Padding="0,5" Margin="0,0,12,0" Click="CardDown_Click"
                                                                    Visibility="{Binding CanReorder, Converter={StaticResource BoolToVis}}" ToolTip="Descer (menor prioridade)">
                                                                <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="12"/>
                                                            </Button>
                                                            <TextBlock Text="{Binding StateText}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0" Width="64" TextAlignment="Right"/>
                                                            <CheckBox Style="{StaticResource SwitchBox}" IsChecked="{Binding IsOn, Mode=TwoWay}" VerticalAlignment="Center"
                                                                      ToolTip="Ligado/Desligado nesta situação"/>
                                                        </StackPanel>
                                                        <WrapPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                            <Border Background="{StaticResource BgBrush}" CornerRadius="3" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center"
                                                                    Visibility="{Binding IsPiece, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="PEÇA" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                                                            </Border>
                                                            <Border Background="#2A2412" CornerRadius="3" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center"
                                                                    Visibility="{Binding IsModified, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="ALTERADO" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource WarnBrush}"/>
                                                            </Border>
                                                            <Border Width="20" Height="20" CornerRadius="10" Background="{StaticResource BgBrush}" Margin="10,0,0,0" VerticalAlignment="Center"
                                                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                                                <Border.ToolTip>
                                                                    <ToolTip MaxWidth="420"><TextBlock Text="{Binding Help}" TextWrapping="Wrap"/></ToolTip>
                                                                </Border.ToolTip>
                                                                <TextBlock Text="?" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </WrapPanel>
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>

                                                    <!-- frase editavel -->
                                                    <StackPanel Margin="0,12,0,0">
                                                        <StackPanel.Style>
                                                            <Style TargetType="StackPanel">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsOn}" Value="False"><Setter Property="Opacity" Value="0.45"/></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </StackPanel.Style>
                                                        <WrapPanel>
                                                            <TextBlock Text="Mostrar" Style="{StaticResource Word}"/>
                                                            <ComboBox Height="30" MinWidth="170" Margin="4,2" ItemsSource="{Binding Triggers}" ItemTemplate="{StaticResource ChoiceItem}" SelectedValuePath="Value"
                                                                      SelectedValue="{Binding Trigger, Mode=TwoWay}" Visibility="{Binding HasTrigger, Converter={StaticResource BoolToVis}}"
                                                                      ToolTip="Quando aparece: no padrão do tema, sempre, a cada evento do jogo ou periodicamente."/>
                                                            <TextBlock Text="{Binding NativeText}" Style="{StaticResource Word}" Foreground="{StaticResource MutedBrush}"
                                                                       Visibility="{Binding NoTrigger, Converter={StaticResource BoolToVis}}"/>
                                                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsPeriodic, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="a cada" Style="{StaticResource Word}"/>
                                                                <ContentControl Content="{Binding Period}" ContentTemplate="{StaticResource InlineNum}"/>
                                                                <TextBlock Text="s" Style="{StaticResource Word}"/>
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsLaps, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="a cada" Style="{StaticResource Word}"/>
                                                                <ContentControl Content="{Binding EveryLaps}" ContentTemplate="{StaticResource InlineNum}"/>
                                                                <TextBlock Text="voltas" Style="{StaticResource Word}"/>
                                                                <ComboBox Height="30" MinWidth="110" Margin="4,2" ItemsSource="{Binding LapsOfs}" ItemTemplate="{StaticResource ChoiceItem}" SelectedValuePath="Value"
                                                                          SelectedValue="{Binding LapsOf, Mode=TwoWay}" ToolTip="Voltas contadas do jogador ou do líder."/>
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" Visibility="{Binding ShowDuration, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="por" Style="{StaticResource Word}" Margin="8,0,2,0"/>
                                                                <ContentControl Content="{Binding Duration}" ContentTemplate="{StaticResource InlineNum}"/>
                                                                <TextBlock Text="s" Style="{StaticResource Word}"/>
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" Visibility="{Binding ShowFades, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="· fade de entrada" Style="{StaticResource Word}" Margin="8,0,2,0"/>
                                                                <ContentControl Content="{Binding FadeIn}" ContentTemplate="{StaticResource InlineNum}"/>
                                                                <TextBlock Text="s, de saída" Style="{StaticResource Word}"/>
                                                                <ContentControl Content="{Binding FadeOut}" ContentTemplate="{StaticResource InlineNum}"/>
                                                                <TextBlock Text="s" Style="{StaticResource Word}"/>
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" Visibility="{Binding HasList, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="· forma" Style="{StaticResource Word}" Margin="8,0,2,0"/>
                                                                <ComboBox Height="30" MinWidth="190" Margin="4,2" ItemsSource="{Binding Forms}" ItemTemplate="{StaticResource ChoiceItem}" SelectedValuePath="Value"
                                                                          SelectedValue="{Binding Form, Mode=TwoWay}"
                                                                          ToolTip="Estática: sempre o topo da lista, como nos prints. Dinâmica: janela que acompanha você, como no iRacing."/>
                                                                <TextBlock Text="com" Style="{StaticResource Word}"/>
                                                                <ContentControl Content="{Binding Rows}" ContentTemplate="{StaticResource InlineNum}"/>
                                                                <TextBlock Text="linhas" Style="{StaticResource Word}"/>
                                                                <StackPanel Orientation="Horizontal" Visibility="{Binding IsDynamic, Converter={StaticResource BoolToVis}}">
                                                                    <TextBlock Text="e" Style="{StaticResource Word}" Margin="6,0,2,0"/>
                                                                    <ContentControl Content="{Binding Around}" ContentTemplate="{StaticResource InlineNum}"/>
                                                                    <TextBlock Text="pilotos ao redor de você" Style="{StaticResource Word}"/>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </WrapPanel>
                                                        <ItemsControl ItemsSource="{Binding Events}" Margin="0,8,0,0" Visibility="{Binding IsEvents, Converter={StaticResource BoolToVis}}">
                                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding Checked, Mode=TwoWay}" Content="{Binding Label}"/>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <ItemsControl ItemsSource="{Binding Timings}" Margin="0,6,0,0" Visibility="{Binding HasTimings, Converter={StaticResource BoolToVis}}">
                                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <StackPanel Orientation="Horizontal" Margin="0,2,16,2" ToolTip="{Binding Range}">
                                                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                                                                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource InlineNum}"/>
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>

                                                    <!-- acoes -->
                                                    <WrapPanel Margin="0,12,0,0">
                                                        <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding PreviewOpen, Mode=TwoWay}" Content="Ver prévia" Padding="12,4"
                                                                      Visibility="{Binding HasPreview, Converter={StaticResource BoolToVis}}" ToolTip="Mostra como o item fica (dados simulados, nunca abre o jogo)."/>
                                                        <Button Style="{StaticResource LinkButton}" Content="Ajustar posição" Margin="0,0,6,6" Click="CardPosition_Click"
                                                                ToolTip="Abre o editor de posição e tamanho deste item (aba Avançado)."/>
                                                        <Button Style="{StaticResource LinkButton}" Content="Restaurar padrão do tema" Margin="0,0,6,6" Click="CardReset_Click"
                                                                ToolTip="Volta este cartão ao comportamento original do tema."/>
                                                    </WrapPanel>
                                                    <StackPanel Visibility="{Binding PreviewOpen, Converter={StaticResource BoolToVis}}" Margin="0,4,0,0">
                                                        <Image Source="{Binding PreviewImage}" MaxHeight="150" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left"
                                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                                        <TextBlock Text="{Binding PreviewStatus}" Style="{StaticResource Muted}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ===== Widgets (Avancado) ===== -->
            <Border x:Name="WidgetsPanel" Grid.Row="1" Grid.Column="2" Visibility="Collapsed" Style="{StaticResource Card}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="WIDGETS" Style="{StaticResource SectionTitle}" Margin="0"/>
                        <TextBlock Text="Arraste ≡ para reordenar" Style="{StaticResource Muted}" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <Border DockPanel.Dock="Bottom" Margin="0,12,0,0" Padding="12" Background="{StaticResource BgBrush}" CornerRadius="6"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Height="190">
                        <Grid>
                            <TextBlock x:Name="PreviewCaption" Text="PRÉVIA" Style="{StaticResource SectionTitle}" VerticalAlignment="Top" Margin="0"/>
                            <StackPanel x:Name="BoardModeBar" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed"
                                        ToolTip="Modo do board na prévia (dados simulados de uma corrida de 20 carros)">
                                <ToggleButton Content="Torre" Tag="0" IsChecked="True" Click="BoardMode_Click" Style="{StaticResource ToggleButtonStyle}" Padding="10,1" Margin="0,0,4,0"/>
                                <ToggleButton Content="Setor" Tag="1" Click="BoardMode_Click" Style="{StaticResource ToggleButtonStyle}" Padding="10,1" Margin="0,0,4,0"/>
                                <ToggleButton Content="Voltas" Tag="2" Click="BoardMode_Click" Style="{StaticResource ToggleButtonStyle}" Padding="10,1" Margin="0,0,4,0"/>
                                <ToggleButton Content="Legenda" Tag="3" Click="BoardMode_Click" Style="{StaticResource ToggleButtonStyle}" Padding="10,1"/>
                            </StackPanel>
                            <Image x:Name="PreviewImage" Margin="0,22,0,0" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock x:Name="PreviewStatus" Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,22,0,0"/>
                        </Grid>
                    </Border>
                    <ListBox x:Name="WidgetsList" AllowDrop="True" SelectionChanged="WidgetsList_SelectionChanged"
                             PreviewMouseLeftButtonDown="WidgetsList_PreviewMouseLeftButtonDown" PreviewMouseMove="WidgetsList_PreviewMouseMove"
                             DragOver="WidgetsList_DragOver" DragLeave="WidgetsList_DragLeave" Drop="WidgetsList_Drop">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderThickness="0,2,0,0" Padding="0,8">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DropTarget}" Value="True"><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <DockPanel Margin="8,0">
                                        <TextBlock x:Name="Grip" DockPanel.Dock="Left" Text="&#xE700;" FontFamily="{StaticResource IconFont}" FontSize="14" Width="26"
                                                   Foreground="{StaticResource MutedBrush}" Cursor="SizeAll" VerticalAlignment="Center" Background="Transparent" Tag="grip"
                                                   ToolTip="Arrastar para reordenar"/>
                                        <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Visible, Mode=TwoWay}" ToolTip="Mostrar/ocultar"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- ===== Detalhes do widget ===== -->
            <Border x:Name="DetailPanel" Grid.Row="1" Grid.Column="4" Visibility="Collapsed" Style="{StaticResource Card}">
                <Grid>
                    <TextBlock x:Name="NoSelection" Text="Selecione um widget" Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <ScrollViewer x:Name="DetailScroll" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel x:Name="Detail" Margin="0,0,10,0">
                            <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>

                            <DockPanel><TextBlock Text="Largura da janela" Style="{StaticResource Muted}"/><TextBlock Text="{Binding WidthScalePct, StringFormat={}{0}%}" HorizontalAlignment="Right"/></DockPanel>
                            <Slider Minimum="25" Maximum="300" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding WidthScalePct, Mode=TwoWay}" Margin="0,4,0,12"/>
                            <DockPanel><TextBlock Text="Altura da janela" Style="{StaticResource Muted}"/><TextBlock Text="{Binding HeightScalePct, StringFormat={}{0}%}" HorizontalAlignment="Right"/></DockPanel>
                            <Slider Minimum="25" Maximum="300" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding HeightScalePct, Mode=TwoWay}" Margin="0,4,0,12"/>
                            <DockPanel><TextBlock Text="Escala" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Scale, StringFormat={}{0:0.00}x}" HorizontalAlignment="Right"/></DockPanel>
                            <Slider Minimum="0.5" Maximum="3" TickFrequency="0.05" IsSnapToTickEnabled="True" SmallChange="0.05" LargeChange="0.25" Value="{Binding Scale, Mode=TwoWay}" Margin="0,4,0,14"/>

                            <DockPanel><TextBlock Text="Opacidade" Style="{StaticResource Muted}"/><TextBlock Text="{Binding OpacityPct, StringFormat={}{0:0}%}" HorizontalAlignment="Right"/></DockPanel>
                            <Slider Minimum="20" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="10" Value="{Binding OpacityPct, Mode=TwoWay}" Margin="0,4,0,14"/>

                            <TextBlock Text="Fonte do texto" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                            <ComboBox x:Name="FontCombo" Height="32" SelectedItem="{Binding FontChoice, Mode=TwoWay}" Margin="0,0,0,14"/>

                            <StackPanel x:Name="SessionsPanel" Margin="0,0,0,14">
                                <TextBlock Text="Mostrar em" Style="{StaticResource Muted}" Margin="0,0,0,6"
                                           ToolTip="Tipos de sessão em que o widget aparece (como no iRacing). Fora de uma sessão (menu) todos aparecem."/>
                                <WrapPanel>
                                    <CheckBox Content="Treino" IsChecked="{Binding ShowPractice, Mode=TwoWay}" Margin="0,0,16,0" ToolTip="Treino, teste e time attack"/>
                                    <CheckBox Content="Classificação" IsChecked="{Binding ShowQualify, Mode=TwoWay}" Margin="0,0,16,0"/>
                                    <CheckBox Content="Corrida" IsChecked="{Binding ShowRace, Mode=TwoWay}" ToolTip="Volta de apresentação e corrida"/>
                                </WrapPanel>
                            </StackPanel>

                            <StackPanel x:Name="ShowPanel" DataContext="{Binding Show}" Margin="0,0,0,14">
                                <StackPanel.Resources>
                                    <DataTemplate x:Key="ShowNum">
                                        <DockPanel Margin="0,0,0,6" ToolTip="{Binding Range}">
                                            <TextBox DockPanel.Dock="Right" Width="80" Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </StackPanel.Resources>
                                <TextBlock Text="EXIBIÇÃO" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"
                                           ToolTip="Quando o widget aparece, por quanto tempo e em que forma. Tudo no padrão = o comportamento original do tema."/>
                                <StackPanel Visibility="{Binding HasTriggers, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Quando aparece" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                                    <ComboBox Height="32" ItemsSource="{Binding Triggers}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Trigger, Mode=TwoWay}" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding NativeLabel}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                                               Visibility="{Binding IsNative, Converter={StaticResource BoolToVis}}"/>
                                    <ItemsControl ItemsSource="{Binding Events}" Margin="0,2,0,8" Visibility="{Binding IsEvents, Converter={StaticResource BoolToVis}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate><CheckBox IsChecked="{Binding Checked, Mode=TwoWay}" Content="{Binding Label}" Margin="0,0,0,5"/></DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ContentControl Content="{Binding Period}" ContentTemplate="{StaticResource ShowNum}" Visibility="{Binding IsPeriodic, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                                <ContentControl Content="{Binding Duration}" ContentTemplate="{StaticResource ShowNum}" Visibility="{Binding ShowDuration, Converter={StaticResource BoolToVis}}"/>
                                <StackPanel Visibility="{Binding ShowFades, Converter={StaticResource BoolToVis}}">
                                    <ContentControl Content="{Binding FadeIn}" ContentTemplate="{StaticResource ShowNum}"/>
                                    <ContentControl Content="{Binding FadeOut}" ContentTemplate="{StaticResource ShowNum}"/>
                                </StackPanel>
                                <StackPanel Visibility="{Binding HasList, Converter={StaticResource BoolToVis}}" Margin="0,4,0,0">
                                    <TextBlock Text="Forma da lista" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                                    <ComboBox Height="32" ItemsSource="{Binding Forms}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Form, Mode=TwoWay}" Margin="0,0,0,6"/>
                                    <ContentControl Content="{Binding Rows}" ContentTemplate="{StaticResource ShowNum}"/>
                                    <ContentControl Content="{Binding Around}" ContentTemplate="{StaticResource ShowNum}" Visibility="{Binding IsDynamic, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding Timings}" ItemTemplate="{StaticResource ShowNum}" Margin="0,4,0,0" Visibility="{Binding HasTimings, Converter={StaticResource BoolToVis}}"/>
                                <StackPanel Visibility="{Binding HasPieces, Converter={StaticResource BoolToVis}}" Margin="0,4,0,0">
                                    <TextBlock Text="Peças" Style="{StaticResource Muted}" Margin="0,0,0,6" ToolTip="Cada peça do board pode ser desligada ou ficar mais/menos tempo na tela. A ordem de prioridade é a do tema."/>
                                    <ItemsControl ItemsSource="{Binding Pieces}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,0,6">
                                                    <CheckBox Content="{Binding Label}" IsChecked="{Binding Enabled, Mode=TwoWay}" Margin="0,0,0,4"/>
                                                    <StackPanel Margin="22,0,0,0" Visibility="{Binding Enabled, Converter={StaticResource BoolToVis}}">
                                                        <ComboBox Height="28" ItemsSource="{Binding Triggers}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                                                  SelectedValue="{Binding Trigger, Mode=TwoWay}" Margin="0,0,0,4"
                                                                  ToolTip="Padrão = a peça aparece pela regra do tema. Por evento/periódico = só dentro da janela do gatilho."/>
                                                        <ItemsControl ItemsSource="{Binding Events}" Margin="0,2,0,4" Visibility="{Binding IsEvents, Converter={StaticResource BoolToVis}}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate><CheckBox IsChecked="{Binding Checked, Mode=TwoWay}" Content="{Binding Label}" Margin="0,0,0,4"/></DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <ContentControl Content="{Binding Period}" ContentTemplate="{StaticResource ShowNum}" Visibility="{Binding IsPeriodic, Converter={StaticResource BoolToVis}}"/>
                                                        <ContentControl Content="{Binding Duration}" ContentTemplate="{StaticResource ShowNum}"
                                                                        Visibility="{Binding HasDuration, Converter={StaticResource BoolToVis}}"/>
                                                        <StackPanel Visibility="{Binding IsTimed, Converter={StaticResource BoolToVis}}">
                                                            <ContentControl Content="{Binding FadeIn}" ContentTemplate="{StaticResource ShowNum}"/>
                                                            <ContentControl Content="{Binding FadeOut}" ContentTemplate="{StaticResource ShowNum}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <Button Content="Restaurar padrão do tema" Click="ResetShow_Click" Margin="0,4,0,0" HorizontalAlignment="Left" Padding="10,3"/>
                            </StackPanel>

                            <StackPanel x:Name="RowsPanel" Margin="0,0,0,14">
                                <TextBlock Text="{Binding RowsLabel}" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="−" Width="34" Click="RowsMinus_Click"/>
                                    <TextBlock Text="{Binding Rows}" Width="44" TextAlignment="Center" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold"/>
                                    <Button Content="+" Width="34" Click="RowsPlus_Click"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel x:Name="SelectionPanel" Margin="0,0,0,14">
                                <TextBlock Text="Pilotos no topo" Style="{StaticResource Muted}" Margin="0,0,0,4" ToolTip="Primeiros N da classificação, sempre visíveis."/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button Content="−" Width="34" Click="TopMinus_Click"/>
                                    <TextBlock Text="{Binding TopCount}" Width="44" TextAlignment="Center" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold"/>
                                    <Button Content="+" Width="34" Click="TopPlus_Click"/>
                                </StackPanel>
                                <TextBlock Text="Perto de mim (ao redor do jogador)" Style="{StaticResource Muted}" Margin="0,0,0,4"
                                           ToolTip="Janela centrada no jogador, incluindo ele. Entre o topo e a janela aparece &quot;...&quot; quando há salto de posições."/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="−" Width="34" Click="NearMinus_Click"/>
                                    <TextBlock Text="{Binding NearCount}" Width="44" TextAlignment="Center" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold"/>
                                    <Button Content="+" Width="34" Click="NearPlus_Click"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel x:Name="RadarPanel" Margin="0,0,0,14">
                                <TextBlock Text="Alcance do painel (metros à frente e atrás)" Style="{StaticResource Muted}" Margin="0,0,0,4" ToolTip="Só vale no estilo painel (coluna &quot;Estilo painel&quot;). O indicador nativo do AMS2 só aparece com carro ao lado."/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button Content="−" Width="34" Click="RadarRangeMinus_Click"/>
                                    <TextBlock Text="{Binding RadarRange, StringFormat={}{0} m}" Width="64" TextAlignment="Center" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold"/>
                                    <Button Content="+" Width="34" Click="RadarRangePlus_Click"/>
                                </StackPanel>
                                <TextBlock Text="Sensibilidade (carro ao lado)" Style="{StaticResource Muted}" Margin="0,0,0,4" ToolTip="Quão longe à frente/atrás ainda conta como &quot;ao lado&quot; (padrão 4 m; 1 = metade, 5 = uma vez e meia). No estilo painel também escala as janelas de aviso."/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="−" Width="34" Click="RadarSensMinus_Click"/>
                                    <TextBlock Text="{Binding RadarSensitivity}" Width="64" TextAlignment="Center" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold"/>
                                    <Button Content="+" Width="34" Click="RadarSensPlus_Click"/>
                                </StackPanel>
                                <TextBlock Text="{Binding RadarSensitivityText}" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                            </StackPanel>

                            <StackPanel x:Name="ThemeOptionsPanel" Margin="0,0,0,14">
                                <TextBlock Text="Opções do tema" Style="{StaticResource Muted}" Margin="0,0,0,6" ToolTip="Opções que só existem neste tema."/>
                                <ItemsControl ItemsSource="{Binding ThemeOptions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Label}" Margin="0,0,0,4" Visibility="{Binding IsChoice, Converter={StaticResource BoolToVis}}"/>
                                                <ComboBox Height="32" ItemsSource="{Binding Choices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Value, Mode=TwoWay}"
                                                          Visibility="{Binding IsChoice, Converter={StaticResource BoolToVis}}"/>
                                                <CheckBox Content="{Binding Label}" IsChecked="{Binding Checked, Mode=TwoWay}" Visibility="{Binding IsToggle, Converter={StaticResource BoolToVis}}"/>
                                                <DockPanel Visibility="{Binding IsNumber, Converter={StaticResource BoolToVis}}">
                                                    <TextBox DockPanel.Dock="Right" Width="80" Text="{Binding NumberText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                                                </DockPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel x:Name="ColumnsPanel" Margin="0,0,0,14">
                                <TextBlock Text="Colunas visíveis" Style="{StaticResource Muted}" Margin="0,0,0,6"/>
                                <ItemsControl ItemsSource="{Binding Columns}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate><CheckBox IsChecked="{Binding IsVisible, Mode=TwoWay}" Content="{Binding Label}" Margin="0,0,0,7"/></DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel x:Name="WidthsPanel" Margin="0,0,0,14">
                                <TextBlock Text="Largura das colunas" Style="{StaticResource Muted}" Margin="0,0,0,6"
                                           ToolTip="% da largura do tema (100% = padrão). O widget cresce ou encolhe junto."/>
                                <ItemsControl ItemsSource="{Binding Widths}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,6">
                                                <DockPanel><TextBlock Text="{Binding Label}"/><TextBlock Text="{Binding Pct, StringFormat={}{0}%}" HorizontalAlignment="Right"/></DockPanel>
                                                <Slider Minimum="50" Maximum="250" TickFrequency="5" IsSnapToTickEnabled="True" SmallChange="5" LargeChange="25" Value="{Binding Pct, Mode=TwoWay}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <TextBlock Text="TEXTO" Style="{StaticResource SectionTitle}" Margin="0,4,0,8"/>
                            <DockPanel ToolTip="Altera somente as fontes; largura e altura são ajustadas separadamente."><TextBlock Text="Tamanho do texto" Style="{StaticResource Muted}"/><TextBlock Text="{Binding TextScalePct, StringFormat={}{0}%}" HorizontalAlignment="Right"/></DockPanel>
                            <Slider Minimum="40" Maximum="200" TickFrequency="5" IsSnapToTickEnabled="True" SmallChange="5" LargeChange="10" Value="{Binding TextScalePct, Mode=TwoWay}" Margin="0,4,0,12"/>
                            <TextBlock Text="Peso da fonte" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                            <ComboBox Height="32" ItemsSource="{x:Static local:Choices.Weights}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding FontWeightChoice, Mode=TwoWay}" Margin="0,0,0,12"/>
                            <Expander Header="Fontes por elemento" Margin="0,0,0,14" ToolTip="100% herda o tamanho geral; o peso padrão herda o peso geral. Ajustes se aplicam aos elementos presentes neste widget.">
                                <ItemsControl ItemsSource="{Binding ElementFonts}" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,12">
                                                <DockPanel><TextBlock Text="{Binding Label}"/><TextBlock Text="{Binding Pct, StringFormat={}{0}%}" HorizontalAlignment="Right"/></DockPanel>
                                                <Slider Minimum="40" Maximum="200" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding Pct, Mode=TwoWay}" Margin="0,4,0,4"/>
                                                <ComboBox Height="30" ItemsSource="{x:Static local:Choices.Weights}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Weight, Mode=TwoWay}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                            <TextBlock Text="Cores (#RRGGBB; vazio = cor do tema)" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Textos" VerticalAlignment="Center" ToolTip="Nomes e títulos"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding TextColor, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Margin="0,2,6,2"/>
                                <Border Grid.Row="0" Grid.Column="2" Width="22" Height="22" CornerRadius="3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="{Binding TextColor, FallbackValue=Transparent, TargetNullValue=Transparent}"/>
                                <TextBlock Grid.Row="1" Text="Rótulos" VerticalAlignment="Center" ToolTip="AHEAD/BEHIND, LAPS, AIR... (no 2004 os rótulos ficam em células brancas e seguem a cor de Textos)"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding LabelColor, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Margin="0,2,6,2"/>
                                <Border Grid.Row="1" Grid.Column="2" Width="22" Height="22" CornerRadius="3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="{Binding LabelColor, FallbackValue=Transparent, TargetNullValue=Transparent}"/>
                                <TextBlock Grid.Row="2" Text="Valores" VerticalAlignment="Center" ToolTip="Gaps, tempos, números"/>
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ValueColor, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Margin="0,2,6,2"/>
                                <Border Grid.Row="2" Grid.Column="2" Width="22" Height="22" CornerRadius="3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="{Binding ValueColor, FallbackValue=Transparent, TargetNullValue=Transparent}"/>
                            </Grid>

                            <StackPanel x:Name="FormatPanel" Margin="0,0,0,14">
                                <TextBlock Text="FORMATO" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                                <StackPanel Visibility="{Binding HasName, Converter={StaticResource BoolToVis}}" Margin="0,0,0,10">
                                    <TextBlock Text="Nome do piloto" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                                    <ComboBox Height="32" ItemsSource="{x:Static local:Choices.Names}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding NameChoice, Mode=TwoWay}"/>
                                    <CheckBox Content="Mostrar número do carro (#N)" IsChecked="{Binding CarNumber, Mode=TwoWay}" Margin="0,6,0,0"/>
                                </StackPanel>
                                <StackPanel Visibility="{Binding HasGap, Converter={StaticResource BoolToVis}}" Margin="0,0,0,10">
                                    <TextBlock Text="Gap (casas decimais e sinal)" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <ComboBox Height="32" ItemsSource="{x:Static local:Choices.Decimals}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding GapDecimals, Mode=TwoWay}"/>
                                        <ComboBox Grid.Column="2" Height="32" ItemsSource="{x:Static local:Choices.Signs}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding GapSign, Mode=TwoWay}"/>
                                    </Grid>
                                    <CheckBox Content="Sufixo &quot;s&quot; (1.234s)" IsChecked="{Binding GapSuffix, Mode=TwoWay}" Margin="0,6,0,0"/>
                                </StackPanel>
                                <StackPanel Visibility="{Binding HasLapTime, Converter={StaticResource BoolToVis}}" Margin="0,0,0,10">
                                    <TextBlock Text="Tempo de volta (formato e casas)" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <ComboBox Height="32" ItemsSource="{x:Static local:Choices.LapStyles}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding LapStyle, Mode=TwoWay}"/>
                                        <ComboBox Grid.Column="2" Height="32" ItemsSource="{x:Static local:Choices.Decimals}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding LapDecimals, Mode=TwoWay}"/>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Visibility="{Binding HasSpeed, Converter={StaticResource BoolToVis}}" Margin="0,0,0,10">
                                    <TextBlock Text="Velocidade / distância" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                                    <ComboBox Height="32" ItemsSource="{x:Static local:Choices.Speeds}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding SpeedChoice, Mode=TwoWay}"/>
                                </StackPanel>
                                <StackPanel Visibility="{Binding HasTemp, Converter={StaticResource BoolToVis}}" Margin="0,0,0,10">
                                    <TextBlock Text="Temperatura" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                                    <ComboBox Height="32" ItemsSource="{x:Static local:Choices.Temps}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding TempChoice, Mode=TwoWay}"/>
                                </StackPanel>
                                <StackPanel Visibility="{Binding HasFuel, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Combustível" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                                    <ComboBox Height="32" ItemsSource="{x:Static local:Choices.Fuels}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding FuelChoice, Mode=TwoWay}"/>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Text="Posição (px)" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="X" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox Grid.Column="1" Text="{Binding X, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                                <TextBlock Grid.Column="3" Text="Y" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox Grid.Column="4" Text="{Binding Y, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                            </Grid>

                            <Button Content="Restaurar padrões do widget" Click="ResetWidget_Click"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ===== Piloto e pintura (identidade de exibicao por modelo de carro, do catalogo de pinturas do jogo) ===== -->
        <Border x:Name="NamesPanel" Grid.Row="3" Visibility="Collapsed" Padding="24,12,24,14" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Content="Pasta do jogo…" Padding="10,3" Click="GameFolder_Click"
                            ToolTip="Pasta do Automobilista 2 de onde o catálogo de pinturas é lido (UserData e Vehicles). Normalmente é achada sozinha."/>
                    <TextBlock Text="PILOTO E PINTURA" Style="{StaticResource SectionTitle}" Margin="0,0,16,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="NamesCurrent" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="200"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Modelo do carro" Style="{StaticResource Muted}"/>
                    <TextBlock Grid.Column="1" Text="Nome no jogo" Style="{StaticResource Muted}"/>
                    <TextBlock Grid.Column="2" Text="Piloto · equipe · país nos widgets" Style="{StaticResource Muted}"/>
                </Grid>
                <TextBlock x:Name="NamesEmpty" DockPanel.Dock="Top" Style="{StaticResource Muted}" Margin="0,4,0,0"
                           Text="Nenhum carro visto ainda: entre numa sessão no AMS2 com o overlay aberto."/>
                <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="NamesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="230"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="200"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Model}" TextTrimming="CharacterEllipsis" MaxWidth="190" ToolTip="{Binding Model}"/>
                                        <Border Background="{StaticResource AccentDimBrush}" CornerRadius="3" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                                Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="ATUAL" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding OriginalLabel}" Style="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"
                                               ToolTip="Somente leitura: o nome que o jogo dá ao seu carro"/>
                                    <TextBlock Grid.Column="2" Text="{Binding IdentityLabel}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"
                                               ToolTip="{Binding Livery}"/>
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="Escolher pintura…" Padding="8,3" Margin="0,0,6,0" Click="PickLivery_Click"/>
                                        <Button Content="Limpar" Padding="8,3" IsEnabled="{Binding HasIdentity}" Click="ClearLivery_Click"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ===== Tema da vitoria (audio do usuario, escolhido pelo nome do piloto) ===== -->
        <Border x:Name="VictoryPanel" Grid.Row="3" Visibility="Collapsed" Padding="24,12,24,14" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel>
                <DockPanel Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Content="Parar" Padding="12,3" Click="VictoryStop_Click" ToolTip="Interrompe o áudio que estiver tocando."/>
                    <TextBlock Text="TEMA DA VITÓRIA" Style="{StaticResource SectionTitle}" Margin="0,0,16,0" VerticalAlignment="Center"/>
                    <CheckBox x:Name="VictoryEnabled" Content="Ativar" VerticalAlignment="Center" Margin="0,0,16,0" Click="VictoryEnabled_Click"
                              ToolTip="Toca o áudio quando você vence uma corrida (nunca em treino, classificação ou replay)."/>
                    <TextBlock Text="Volume" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Slider x:Name="VictoryVolume" Width="160" Minimum="0" Maximum="100" VerticalAlignment="Center" ValueChanged="VictoryVolume_Changed"/>
                    <TextBlock x:Name="VictoryVolumeText" Width="40" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="VictoryCurrent" Margin="16,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
                <Grid Margin="0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Padrão" VerticalAlignment="Center"/>
                    <TextBlock x:Name="VictoryFileDefault" Grid.Column="1" Style="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                    <Button Grid.Column="2" Content="Escolher arquivo…" Tag="Default" Padding="10,3" Margin="0,0,6,0" Click="VictoryPick_Click"/>
                    <Button Grid.Column="3" Content="Testar" Tag="Default" Padding="10,3" Margin="0,0,6,0" Click="VictoryTest_Click"/>
                    <Button Grid.Column="4" Content="Limpar" Tag="Default" Padding="10,3" Click="VictoryClear_Click"/>
                </Grid>
                <Grid Margin="0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Senna" VerticalAlignment="Center"/>
                    <TextBlock x:Name="VictoryFileSenna" Grid.Column="1" Style="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                    <Button Grid.Column="2" Content="Escolher arquivo…" Tag="Senna" Padding="10,3" Margin="0,0,6,0" Click="VictoryPick_Click"/>
                    <Button Grid.Column="3" Content="Testar" Tag="Senna" Padding="10,3" Margin="0,0,6,0" Click="VictoryTest_Click"/>
                    <Button Grid.Column="4" Content="Limpar" Tag="Senna" Padding="10,3" Click="VictoryClear_Click"/>
                </Grid>
                <Grid Margin="0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Barrichello" VerticalAlignment="Center"/>
                    <TextBlock x:Name="VictoryFileBarrichello" Grid.Column="1" Style="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                    <Button Grid.Column="2" Content="Escolher arquivo…" Tag="Barrichello" Padding="10,3" Margin="0,0,6,0" Click="VictoryPick_Click"/>
                    <Button Grid.Column="3" Content="Testar" Tag="Barrichello" Padding="10,3" Margin="0,0,6,0" Click="VictoryTest_Click"/>
                    <Button Grid.Column="4" Content="Limpar" Tag="Barrichello" Padding="10,3" Click="VictoryClear_Click"/>
                </Grid>
                <Grid Margin="0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Massa" VerticalAlignment="Center"/>
                    <TextBlock x:Name="VictoryFileMassa" Grid.Column="1" Style="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                    <Button Grid.Column="2" Content="Escolher arquivo…" Tag="Massa" Padding="10,3" Margin="0,0,6,0" Click="VictoryPick_Click"/>
                    <Button Grid.Column="3" Content="Testar" Tag="Massa" Padding="10,3" Margin="0,0,6,0" Click="VictoryTest_Click"/>
                    <Button Grid.Column="4" Content="Limpar" Tag="Massa" Padding="10,3" Click="VictoryClear_Click"/>
                </Grid>
                <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"
                           Text="Escolha mp3, wav, wma ou m4a: o arquivo é copiado para a pasta do app. O tema vem do nome do piloto (sobrenome Senna, Barrichello ou Massa); outro nome, ou tema sem arquivo, usa o Padrão."/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
